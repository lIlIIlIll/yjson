  "frozen_consumer_sources": {
    "old-consumers/core/src/compat.cj": {
      "sha256": "31fd85a9c3d8684f2faaa19b99f078d3aef144ab2c7d1fcb9bc297f78e96a118",
      "source": "package frozen_core_consumer\n\nimport yjson.*\nimport yjson_algorithms.*\nimport yjson_macros.*\nimport yjson_schema_formats.*\n\n@JsonCodec\nclass FrozenPerson {\n    public let id: Int64\n    public let name: String\n    public init(id: Int64, name: String) { this.id = id; this.name = name }\n}\n\npublic func runCompatibilityMatrix(): Unit {\n    let scalarText = YJson.toJson(41i64)\n    if (scalarText != \"41\" || YJson.fromJson<Int64>(scalarText) != 41) {\n        throw Exception(\"ordinary encode/decode\")\n    }\n    let document = YJson.parseDocument(\"{\\\"items\\\":[1,2,3]}\")\n    if (document.root().member(\"items\").getOrThrow().element(2).getOrThrow().asInt64() != 3) {\n        throw Exception(\"parseDocument\")\n    }\n\n    let generatedText = YJson.toJson(FrozenPerson(7, \"Ada\"))\n    let generated = YJson.fromJson<FrozenPerson>(generatedText)\n    if (generatedText != \"{\\\"id\\\":7,\\\"name\\\":\\\"Ada\\\"}\" ||\n        generated.id != 7 || generated.name != \"Ada\") {\n        throw Exception(\"generated codec/support v1\")\n    }\n\n    let root = JsonNode.parse(\"{\\\"users\\\":[{\\\"id\\\":7}]}\")\n    if (JsonPointer.parse(\"/users/0/id\").evaluate(root).asInt64() != 7) {\n        throw Exception(\"pointer\")\n    }\n    let patch = JsonPatch.parse(\"[{\\\"op\\\":\\\"replace\\\",\\\"path\\\":\\\"/users/0/id\\\",\\\"value\\\":9}]\")\n    if (patch.apply(root)[\"users\"][0][\"id\"].asInt64() != 9) { throw Exception(\"patch\") }\n    let matches = JsonPath.parse(\"$.users[*].id\").collectValues(root)\n    if (matches.size != 1 || matches[0].asInt64() != 7) { throw Exception(\"path\") }\n    let schema = JsonSchema.parse(\"{\\\"type\\\":\\\"object\\\",\\\"required\\\":[\\\"users\\\"]}\")\n    if (!schema.validate(root).isEmpty()) { throw Exception(\"schema\") }\n\n    let formats = JsonSchemaFormatRegistry.withCoreFormats()\n    formats.install(StandardInternationalFormats())\n    let config = JsonSchemaConfig(formatMode: JsonSchemaFormatMode.Assertion, formats: formats)\n    let formatSchema = JsonSchema.parse(\"{\\\"format\\\":\\\"idn-hostname\\\"}\", config: config)\n    if (!formatSchema.validator().isValid(JsonNode.string(\"실례.테스트\"))) {\n        throw Exception(\"schema formats dynamic\")\n    }\n    println(\"core|41|3|{\\\"id\\\":7,\\\"name\\\":\\\"Ada\\\"}|pointer=7|patch=9|path=7|schema=ok|idn=ok\")\n}\n"
    },
