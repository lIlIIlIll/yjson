    "old-consumers/native/src/compat.cj": {
      "sha256": "373972a5d46399cb2c69dc4f94daff8b30702afdd0e87923453c5837557c8df9",
      "source": "package frozen_native_consumer\n\nimport yjson.*\nimport yjson_backends.*\nimport yjson_native.*\n\npublic func runCompatibilityMatrix(): Unit {\n    let document = NativeBackends.customNative.parseDocument(\"{\\\"native\\\":42}\")\n    if (document.isClosed()) { throw Exception(\"native initially closed\") }\n    if (document.root().member(\"native\").getOrThrow().asInt64() != 42) {\n        throw Exception(\"native root\")\n    }\n    document.close()\n    if (!document.isClosed()) { throw Exception(\"native close\") }\n    println(\"native|42|closed=true\")\n}\n"
    },
    "old-consumers/native_accel/src/compat.cj": {
      "sha256": "deb013649fe4fd9908bc378d38f7c3d8bd9d1806367066a6298952d05bcfca4c",
      "source": "package frozen_native_accel_consumer\n\nimport yjson.*\nimport yjson_native_accel.*\n\npublic func runCompatibilityMatrix(): Unit {\n    YJsonNativeAccel.initialize()\n    let document = YJson.parseDocument(\"{\\\"accelerated\\\":42}\")\n    if (document.root().member(\"accelerated\").getOrThrow().asInt64() != 42) {\n        throw Exception(\"native accel\")\n    }\n    println(\"native-accel|42\")\n}\n"
    },
    "old-consumers/yyjson/src/compat.cj": {
      "sha256": "bac03901c3d43e5a604a5d0ab87af85c1b1d7f2ccef7b4afd791e0d4d74bb4e1",
      "source": "package frozen_yyjson_consumer\n\nimport yjson.*\nimport yjson_backends.*\nimport yjson_yyjson.*\n\npublic func runCompatibilityMatrix(): Unit {\n    let document = YyjsonBackends.yyjson.parseDocument(\"{\\\"yyjson\\\":42}\")\n    if (document.isClosed()) { throw Exception(\"yyjson initially closed\") }\n    if (document.root().member(\"yyjson\").getOrThrow().asInt64() != 42) {\n        throw Exception(\"yyjson root\")\n    }\n    document.close()\n    if (!document.isClosed()) { throw Exception(\"yyjson close\") }\n    println(\"yyjson|42|closed=true\")\n}\n"
    }
